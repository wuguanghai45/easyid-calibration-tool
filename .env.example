# Serial barcode scanner for VIN (see demo/sn_scaner_demo.py)
# SN_SCANNER_PORT=COM4
# SN_SCANNER_BAUDRATE=115200
# SN_SCANNER_READ_TIMEOUT=3.0

# Feishu custom app credentials (https://open.feishu.cn/app)
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Wiki node token (from feishu.cn/wiki/... URL)
FEISHU_WIKI_TOKEN=

# Bitable data table id (from bitable URL)
FEISHU_TABLE_ID=

# Bitable view_id (from table URL, used for record search)
FEISHU_VIEW_ID=

# Wiki get_node obj_type; default wiki
# FEISHU_OBJ_TYPE=wiki
